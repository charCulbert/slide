{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake -B build && cmake --build build --parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run in clap-host",
      "type": "shell",
      "command": "clap-host",
      "args": [
        "build/Slide Lab.clap",
        "--script",
        ".vscode/clap-host.txt"
      ],
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}
